# Postgres connection string for the app (Neon). Use the pooled
# connection string for runtime; drizzle-kit may need the direct/unpooled
# one for migrations depending on Neon's current pooler guidance.
DATABASE_URL=

# Random 32+ byte secret used to sign the admin session JWT. Generate
# with: openssl rand -base64 32
# Never reuse the same value across Preview and Production.
SESSION_SECRET=

# Vercel Blob store token (Project Settings > Storage > Blob).
BLOB_READ_WRITE_TOKEN=

# Shared secret the devotional cron route checks in its Authorization
# header. Must match what's configured on the Vercel Cron trigger.
CRON_SECRET=

# ntfy.sh topic for best-effort push notifications (new contact message,
# new RSVP, devotional sync failure). Optional — notifications are
# skipped if unset.
NTFY_TOPIC=

# --- one-off migration script only, not used by the running app ---
# Supabase project's direct Postgres connection string (Project Settings
# > Database > Connection string > URI, "Direct connection" — must be
# the postgres superuser so the read bypasses RLS). Only needed when
# running `npm run migrate-from-supabase`.
SUPABASE_DB_URL=
